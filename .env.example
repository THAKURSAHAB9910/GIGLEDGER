# ==============================================================================
# GIGLEDGER Environment Variables Template
# Copy this file to .env and adjust values for your environment.
# DO NOT COMMIT SECRETS OR PASSWORDS TO VERSION CONTROL.
# ==============================================================================

# --- Frontend Environment Variables (Vercel) ---
# URL of the decoupled backend API.
# Leave empty or set to '/api' if running backend on same host or using fallback mode.
# Example: https://gigledger-api.onrender.com or https://gigledger-api.railway.app
NEXT_PUBLIC_API_URL=https://gigledger-api.onrender.com
VITE_API_URL=https://gigledger-api.onrender.com

# --- Backend Environment Variables (Railway / Render / Docker) ---
# Port for FastAPI uvicorn runner (Render/Railway sets PORT dynamically)
PORT=8000
HOST=0.0.0.0

# CORS Allowed Origins (Comma-separated list of permitted frontend domains)
ALLOWED_ORIGINS=https://thakursahab9910.github.io,https://gigledger.vercel.app,http://localhost:3000,http://localhost:8501

# Database Connection URL (SQLite default, PostgreSQL supported)
# SQLite Example: sqlite:///gigledger.db
# PostgreSQL Example: postgresql://giguser:securepassword@dbhost.render.com:5432/gigledger
DATABASE_URL=sqlite:///gigledger.db
DB_ECHO=False

# Cryptographic Salt for Worker Pseudonymization (One-way salted SHA-256)
# Set a unique high-entropy random string in production
GIGLEDGER_SALT=gigledger-production-salt-replace-with-secure-key

# Statutory Minimum Wage Benchmark (INR / hour)
STATUTORY_MIN_WAGE_HOURLY=100.0
